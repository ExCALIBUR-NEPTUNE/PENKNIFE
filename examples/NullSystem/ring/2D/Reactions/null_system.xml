<?xml version="1.0" encoding="utf-8" ?>
<NEKTAR>

    <COLLECTIONS DEFAULT="MatrixFree" />

    <!--
        The composite index for the domain is expected to be 0 if the mesh was generated from the included .geo file
     -->
    <EXPANSIONS>
       <E COMPOSITE="C[0]" NUMMODES="3" TYPE="MODIFIED" FIELDS="n,e" />
    </EXPANSIONS>

    <CONDITIONS>
        <SOLVERINFO>
            <I PROPERTY="EQTYPE"                       VALUE="NullSystem"/>
            <I PROPERTY="PARTTYPE"                      VALUE="ReactionSystem"/>
            <I PROPERTY="Projection"                   VALUE="DisContinuous" />
            <!-- <I PROPERTY="LinSysIterSolverTypeInNonlin" VALUE="GMRES"         /> -->
            <!-- <I PROPERTY="UpwindType"                   VALUE="Upwind"        /> -->
        </SOLVERINFO>
        <TIMEINTEGRATIONSCHEME>
            <METHOD> IMEX </METHOD>
            <ORDER> 2 </ORDER>
        </TIMEINTEGRATIONSCHEME>
        <FILTER TYPE="Checkpoint">  
            <PARAM NAME="OutputFrequency">10</PARAM> 
        </FILTER> 

        <PARAMETERS>
            <!-- Conversion of mesh unit to m -->
            <P> mesh_length = 1 </P> 
            <!-- Normalised temperature in eV -->
            <P> Tnorm = 1 </P>
            <!-- Normalised density in m^-3 -->
            <P> Nnorm = 1e18 </P>
            <!-- Normalised magnetic field in T -->
            <P> Bnorm = 1.0 </P>
            <!-- Timestepping and output options -->
            <P> TimeStep      = 5            </P>
            <P> NumSteps      = 10              </P>
            <P> TFinal        = NumSteps*TimeStep </P>
            <P> IO_InfoSteps  = 10     </P>
            <P> IO_CheckSteps  = 10     </P>
            <P> particle_output_freq = 1          </P>
            <P> markers_per_cell = 200          </P>

            <P> epsilon         = 1.0   </P>
            <!-- Anisotropic diffusion -->
            <P> lambda    = 13          </P>
            <P> T_bg      = 10         </P>

            <!-- Scaling factor for ICs -->
            <P> rc = 2 </P>
            <P> ri = 0.5 </P>
            <P> ro = 1 </P>
            <P> yc = 0 </P>                     
            <P> rs = 0.75 </P>
            <P> ys = 0 </P>
            <P> sr = 0.05 </P>
            <P> sy = 0.05 </P>
            
            <!-- Implicit solve params -->
            <P> IterativeSolverTolerance  = 1.0E-8  </P>
            <P> NekNonlinSysMaxIterations = 30       </P>
            <P> NewtonRelativeIteTol      = 1.0E-10  </P>
            <P> NonlinIterTolRelativeL2   = 1.0E-10  </P>
            <P> LinSysRelativeTolInNonlin = 1.0E-02  </P>
        </PARAMETERS>

        <VARIABLES>
            <V ID="0"> n  </V>
            <V ID="1"> e  </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="1"> C[1] </B> <!-- Inner -->
            <B ID="2"> C[2] </B> <!-- Outer -->
        </BOUNDARYREGIONS>
        <BOUNDARYCONDITIONS>
            <REGION REF="1">
                <N VAR="n"  VALUE="0.0" />
                <N VAR="e"  VALUE="0.0" />
            </REGION>
            <REGION REF="2">
                <N VAR="n"  VALUE="0.0" />
                <N VAR="e"  VALUE="0.0" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="InitialConditions">
            <E VAR="n"  DOMAIN="0" VALUE="1" />
            <E VAR="e"  DOMAIN="0" VALUE="(1+0.01*(sin(2*2*PI*(sqrt((x-rc)^2+(y-yc)^2)-ri)/(ro-ri)))^2*sin(16*ang(x-rc, y-yc)))*(0.2-0.1*tanh(2*(sqrt((x-rc)^2+(y-yc)^2)-ri)/(ro-ri)-1))" />

        </FUNCTION>
        <FUNCTION NAME="MagneticField">
            <E VAR="Bx" VALUE="(y-yc)/sqrt((x-rc)*(x-rc)+(y-yc)*(y-yc))" />
            <E VAR="By" VALUE="-(x-rc)/sqrt((x-rc)*(x-rc)+(y-yc)*(y-yc))" />
            <E VAR="Bz" VALUE="10" />
        </FUNCTION>
    </CONDITIONS>
    <NESO>
        <BOUNDARYREGIONS>
            <B ID="1"> C[1] </B> <!-- Inner -->
            <B ID="2"> C[2] </B> <!-- Outer -->
        </BOUNDARYREGIONS>
        <SPECIES>

            <I NAME="D" FIELDS="n">
                <P> Mass = 2.0 </P>
                <P> Charge = 1.0 </P>
                <FUNCTION NAME="InitialConditions">
                    <!-- <E VAR="n"  DOMAIN="0" VALUE="1+0.01*sin(4*2*PI*(sqrt((x-rc)^2+(y-yc)^2)-ri)/(ro-ri))*sin(16*ang(x-rc, y-yc))" /> -->
                    <E VAR="n"  DOMAIN="0" VALUE="(1+0.1*(sin(2*2*PI*(sqrt((x-rc)^2+(y-yc)^2)-ri)/(ro-ri)))^2*sin(16*ang(x-rc, y-yc)))*(2-1*tanh(2*(sqrt((x-rc)^2+(y-yc)^2)-ri)/(ro-ri)-1))" />
                    <E VAR="e"  DOMAIN="0" VALUE="(1+0.01*(sin(2*2*PI*(sqrt((x-rc)^2+(y-yc)^2)-ri)/(ro-ri)))^2*sin(16*ang(x-rc, y-yc)))*(0.2-0.1*tanh(2*(sqrt((x-rc)^2+(y-yc)^2)-ri)/(ro-ri)-1))" />

                </FUNCTION>
            </I>
            <I NAME="T" FIELDS="n">
                <P> Mass = 2.0 </P>
                <P> Charge = 1.0 </P>
                <FUNCTION NAME="InitialConditions">
                    <!-- <E VAR="n"  DOMAIN="0" VALUE="1+0.01*sin(4*2*PI*(sqrt((x-rc)^2+(y-yc)^2)-ri)/(ro-ri))*sin(16*ang(x-rc, y-yc))" /> -->
                    <E VAR="n"  DOMAIN="0" VALUE="(1+0.1*(sin(2*2*PI*(sqrt((x-rc)^2+(y-yc)^2)-ri)/(ro-ri)))^2*sin(16*ang(x-rc, y-yc)))*(2-1*tanh(2*(sqrt((x-rc)^2+(y-yc)^2)-ri)/(ro-ri)-1))" />
                    <E VAR="e"  DOMAIN="0" VALUE="(1+0.01*(sin(2*2*PI*(sqrt((x-rc)^2+(y-yc)^2)-ri)/(ro-ri)))^2*sin(16*ang(x-rc, y-yc)))*(0.2-0.1*tanh(2*(sqrt((x-rc)^2+(y-yc)^2)-ri)/(ro-ri)-1))" />

                </FUNCTION>
            </I>

            <KN NAME="D">
                <P> Mass = 2.0 </P>
                <INITIAL N="1">
                    <E VAR="W" VALUE="0.0001"/>
                    <!-- <E VAR="X" VALUE="1.25"/> -->
                    <!-- <E VAR="Y" VALUE="0"/> -->
                    <E VAR="n" VALUE="exp((-(x-rc+rs)*(x-rc+rs)/(sr*sr))+(-(y-yc-ys)*(y-yc-ys)/(sy*sy)))" />
                    <!-- <E VAR="T" VALUE="10"/> -->
                    <E VAR="V" VALUE="0.01"/>
                </INITIAL>
                <SOURCES>
                    <!-- <P N="100">
                        <E VAR="W" VALUE="1"/>
                        <E VAR="X" VALUE="1.25"/>
                        <E VAR="Y" VALUE="0"/>
                        <E VAR="T" VALUE="10"/>
                        <E VAR="n" VALUE="exp((-(x-2-0.75*cos(150*t))*(x-2-0.75*cos(150*t))/(0.01))+(-(y-0.75*sin(150*t))*(y-0.75*sin(150*t))/(0.01)))"/>
                    </P> -->
                </SOURCES>
            </KN>
            <KN NAME="T">
                <P> Mass = 2.0 </P>
                <INITIAL N="1">
                    <E VAR="W" VALUE="0.0001"/>
                    <!-- <E VAR="X" VALUE="2.75"/> -->
                    <!-- <E VAR="Y" VALUE="0"/> -->
                    <E VAR="n" VALUE="exp((-(x-rc-rs)*(x-rc-rs)/(sr*sr))+(-(y-yc-ys)*(y-yc-ys)/(sy*sy)))" />
                    <!-- <E VAR="T" VALUE="10"/> -->
                    <E VAR="V" VALUE="0.01"/>
                </INITIAL>
                <SOURCES>
                    <!-- <P N="100">
                        <E VAR="W" VALUE="1"/>
                        <E VAR="X" VALUE="2.75"/>
                        <E VAR="Y" VALUE="0"/>
                        <E VAR="T" VALUE="10"/>
                        <E VAR="n" VALUE="exp((-(x-2-0.75*cos(150*t))*(x-2-0.75*cos(150*t))/(0.01))+(-(y-0.75*sin(150*t))*(y-0.75*sin(150*t))/(0.01)))"/>
                    </P> -->
                </SOURCES>
            </KN>
        </SPECIES>
        <VANTAGE>
            <!-- <S TYPE="Specular" SPECIES="D,T">
                <REGION REF="1,2"/>
                <RATE TYPE="Constant" VALUE="0.1"/>
            </S> -->
            <R TYPE="Ionisation" SPECIES="D">
                <RATE TYPE="AMJUEL" VALUE="1"/>
                <CROSSSECTION TYPE="Constant" VALUE="1.0"/>
            </R>
            <R TYPE="Ionisation" SPECIES="T">
                <RATE TYPE="AMJUEL" VALUE="1"/>
                <CROSSSECTION TYPE="Constant" VALUE="1.0"/>
            </R>
            <R TYPE="Recombination" SPECIES="D">
                <RATE TYPE="AMJUEL" VALUE="1"/>
                <CROSSSECTION TYPE="Constant" VALUE="1.0"/>
            </R>
            <!-- <R TYPE="Recombination" SPECIES="T">
                <RATE TYPE="AMJUEL" VALUE="1"/>
                <CROSSSECTION TYPE="Constant" VALUE="1.0"/>
            </R> -->
            <!-- <R TYPE="ChargeExchange" SPECIES="D,T">
                <RATE TYPE="AMJUEL" VALUE="1"/>
                <CROSSSECTION TYPE="Constant" VALUE="1"/>
            </R>
            <R TYPE="ChargeExchange" SPECIES="T,D">
                <RATE TYPE="AMJUEL" VALUE="1"/>
                <CROSSSECTION TYPE="Constant" VALUE="1"/>
            </R> -->

            
            <S TYPE="Absorption" SPECIES="D,T">
                <REGION REF="1,2"/>
                <RATE TYPE="Constant" VALUE="1.0"/>
            </S>
            <!-- <S TYPE="Thermal" SPECIES="D,T">
                <REGION REF="1,2"/>
                <RATE TYPE="Constant" VALUE="0.5"/>
            </S> -->
        </VANTAGE>
    </NESO>
</NEKTAR>
