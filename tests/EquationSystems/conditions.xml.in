<NEKTAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.nektar.info/schema/nektar.xsd">
  <GEOMETRY DIM="2" SPACE="2">
    <VERTEX>
      <V ID="0"> -1.0   -1.0    0.0 </V>
      <V ID="1">  0.0   -1.0    0.0 </V>
      <V ID="2">  1.0   -1.0    0.0 </V>
      <V ID="3"> -1.0    0.0    0.0 </V>
      <V ID="4">  0.0    0.0    0.0 </V>
      <V ID="5">  1.0    0.0    0.0 </V>
      <V ID="6"> -1.0    1.0    0.0 </V>
      <V ID="7">  0.0    1.0    0.0 </V>
      <V ID="8">  1.0    1.0    0.0 </V>
    </VERTEX>
    <EDGE>
      <E ID="0">  0 1  </E>
      <E ID="1">  1 2  </E>
      <E ID="2">  0 3  </E>
      <E ID="3">  1 4  </E>
      <E ID="4">  2 5  </E>
      <E ID="5">  3 4  </E>
      <E ID="6">  4 5  </E>
      <E ID="7">  3 6  </E>
      <E ID="8">  4 7  </E>
      <E ID="9">  5 8  </E>
      <E ID="10"> 6 7  </E>
      <E ID="11"> 7 8  </E>
    </EDGE>
    <ELEMENT>
      <Q ID="0"> 0   3   5   2  </Q>
      <Q ID="1"> 1   4   6   3  </Q>
      <Q ID="2"> 5   8   10  7  </Q>
      <Q ID="3"> 6   9   11  8  </Q>
    </ELEMENT>
    <COMPOSITE>
      <C ID="0"> Q[0-3]       </C>
      <C ID="1"> E[2,7]       </C>
      <C ID="2"> E[4,9]       </C>
      <C ID="3"> E[0,1]       </C>
      <C ID="4"> E[10,11]     </C>
      <C ID="5"> E[3,5,6,8]   </C>
    </COMPOSITE>
    <DOMAIN> C[0] </DOMAIN>
  </GEOMETRY>
  <EXPANSIONS>
    <E COMPOSITE="C[0]" NUMMODES="8" FIELDS="n,v,e,w,phi" TYPE="MODIFIED" />
  </EXPANSIONS>
  <CONDITIONS>
    <PARAMETERS>
      <P>TimeStep = 0.00001</P>
            <P>Manufactured = @MANUFACTURED@</P>
      <P>NumSteps = 1</P>
      <P>k_c = 1</P>
      <P>lambda = 10</P>
      <P>T_bg = 1</P>
      <P>k_par = 0.2</P>
      <P>k_perp = 0.1</P>
    </PARAMETERS>
    <SOLVERINFO>
      <I PROPERTY="EQTYPE" VALUE="@MODEL@" />
      @CLOSURE_INFO@
      <I PROPERTY="Projection" VALUE="@PROJECTION@" />
      <I PROPERTY="UpwindType" VALUE="LaxFriedrichs" />
      <I PROPERTY="OperatorImplementation" VALUE="SumFac" />
      <I PROPERTY="OperatorExecutionSpace" VALUE="Serial" />
    </SOLVERINFO>
    <TIMEINTEGRATIONSCHEME>
      <METHOD> RungeKutta </METHOD>
      <ORDER> 4 </ORDER>
    </TIMEINTEGRATIONSCHEME>
    <GLOBALSYSSOLNINFO>
      <V VAR="n,v,e,w,phi">
        <I PROPERTY="IterativeSolverTolerance" VALUE="1e-13" />
      </V>
    </GLOBALSYSSOLNINFO>
    <VARIABLES>
      <V ID="0">n</V>
      <V ID="1">v</V>
      <V ID="2">e</V>
      <V ID="3">w</V>
      <V ID="4">phi</V>
    </VARIABLES>
    <BOUNDARYREGIONS>
      <B ID="0"> C[1] </B>
      <B ID="1"> C[2] </B>
      <B ID="2"> C[3] </B>
      <B ID="3"> C[4] </B>
    </BOUNDARYREGIONS>
    <BOUNDARYCONDITIONS>
      <REGION REF="0">
        <P VAR="n" VALUE="-[1]" />
        <P VAR="v" VALUE="-[1]" />
        <P VAR="e" VALUE="-[1]" />
        <P VAR="w" VALUE="-[1]" />
        <P VAR="phi" VALUE="-[1]" />
      </REGION>
      <REGION REF="1">
        <P VAR="n" VALUE="[0]" />
        <P VAR="v" VALUE="[0]" />
        <P VAR="e" VALUE="[0]" />
        <P VAR="w" VALUE="[0]" />
        <P VAR="phi" VALUE="[0]" />
      </REGION>
      <REGION REF="2">
        <P VAR="n" VALUE="-[3]" />
        <P VAR="v" VALUE="-[3]" />
        <P VAR="e" VALUE="-[3]" />
        <P VAR="w" VALUE="-[3]" />
        <P VAR="phi" VALUE="-[3]" />
      </REGION>
      <REGION REF="3">
        <P VAR="n" VALUE="[2]" />
        <P VAR="v" VALUE="[2]" />
        <P VAR="e" VALUE="[2]" />
        <P VAR="w" VALUE="[2]" />
        <P VAR="phi" VALUE="[2]" />
      </REGION>
    </BOUNDARYCONDITIONS>
    <FUNCTION NAME="InitialConditions">
      <E VAR="n" VALUE="@DENSITY@" />
      <E VAR="v" VALUE="0" />
      <E VAR="e" VALUE="3" />
      <E VAR="w" VALUE="0" />
      <E VAR="phi" VALUE="0" />
    </FUNCTION>
    <FUNCTION NAME="MagneticField">
      <E VAR="Bx" VALUE="@BX@" />
      <E VAR="By" VALUE="0" />
      <E VAR="Bz" VALUE="1" />
    </FUNCTION>
  </CONDITIONS>
  <NESO>
    <SPECIES>
      <I NAME="ion" FIELDS="@FIELDS@">
        <P>Mass = 2</P>
        <P>Charge = 1</P>
        <FUNCTION NAME="InitialConditions">
          <E VAR="n" VALUE="@DENSITY@" />
          <E VAR="v" VALUE="0" />
          <E VAR="e" VALUE="3" />
        </FUNCTION>
      </I>
      @SECOND_ION@
    </SPECIES>
  </NESO>
</NEKTAR>
